# Frontend (Vite + React)
# Supabase credentials are pre-populated in the hosted environment.
# For local development, copy these from your Supabase project settings.
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ----------------------------------------------------------------------------
# The following are reference values for a standalone Node/Express/MongoDB
# backend deployment (Render). They are NOT used by the Vite frontend in this
# build, which uses Supabase for data + auth. Included for parity with the
# original spec for teams that want to swap in a custom backend later.
# ----------------------------------------------------------------------------
PORT=5000
MONGODB_URI=your_mongodb_atlas_connection_string
JWT_SECRET=your_jwt_secret_key
CLIENT_URL=http://localhost:5173
